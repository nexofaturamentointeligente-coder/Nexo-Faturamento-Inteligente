# Exemplo sem credenciais. Copie para .env somente para desenvolvimento local.
# No Render, preencha as variáveis no painel; não envie .env ao GitHub.
FLASK_ENV=development
# Gere uma chave aleatória própria. Obrigatória e não vazia em produção.
SECRET_KEY=
# Desenvolvimento: vazio usa SQLite local. Produção: PostgreSQL obrigatório.
DATABASE_URL=
# Migrações: conexão direta ou Session pooler, com SSL; não Transaction pooler.
DIRECT_URL=
NEXO_DB_DIRECT=0
PROXY_FIX_HOPS=0
# Origem pública canônica (https://dominio) dos links enviados por e-mail
# (ativação, recuperação de senha, chamados, publicação). Obrigatória e https
# em produção (sem caminho); vazia, vale RENDER_EXTERNAL_URL (Render). Em ambiente
# local, vazia, os links usam http://127.0.0.1:5000.
NEXO_PUBLIC_URL=
# Hosts adicionais aceitos nas requisições (CSV; ".dominio" aceita subdomínios).
# Em produção, o host da origem pública e o da plataforma são aceitos sempre.
NEXO_TRUSTED_HOSTS=
# 1 = Content-Security-Policy em modo somente-relatório (observar sem bloquear).
NEXO_CSP_REPORT_ONLY=0
# 1 = ao definir/redefinir senha, consulta vazamentos conhecidos por k-anonimato
# (só 5 caracteres do hash saem do servidor; a senha nunca). Indisponibilidade do
# serviço NÃO bloqueia a troca (fail-open, registrado em log). Padrão: desligado.
NEXO_SENHAS_VAZADAS=0
# Pool de conexões do SQLAlchemy — só vale com PostgreSQL (ignorado em SQLite).
NEXO_DB_POOL_SIZE=5
NEXO_DB_MAX_OVERFLOW=10
NEXO_DB_POOL_TIMEOUT=10
# 1 = ecoa o SQL no log em desenvolvimento (nunca em produção).
NEXO_SQL_ECHO=0
# Limites por CONTA alvo no login e na recuperação de senha (somados aos limites
# por IP). Mantenha o do login acima de 10/min × janela: um orçamento menor seria
# esgotável de um único IP e trancaria o e-mail alvo (inclusive o do administrador).
NEXO_LIMITE_LOGIN_CONTA=200 per 15 minutes
NEXO_LIMITE_RECUPERACAO_CONTA=10 per hour
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=20
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
RATELIMIT_STORAGE_URI=memory://
# Preencher somente para criação inicial, manual, do administrador.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=
# E-mail: SMTP padrão (Gmail, Zoho, cPanel ou servidor próprio). Sem credenciais,
# o envio fica desativado e o sistema segue funcionando. Depois de alterar, reinicie
# o servidor e confira em Administração > Diagnóstico de e-mail.
#   Porta 587: MAIL_USE_TLS=true e MAIL_USE_SSL=false (STARTTLS).
#   Porta 465: MAIL_USE_SSL=true e MAIL_USE_TLS=false (SSL direto).
# Gmail: verificação em duas etapas + SENHA DE APP em MAIL_PASSWORD (a senha da
# conta é recusada). MAIL_DEFAULT_SENDER: a própria conta de MAIL_USERNAME ou um
# alias autorizado por ela; vazio, vale MAIL_USERNAME. Formato: Nome <email@dominio>.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# API HTTPS do Brevo (porta 443), opcional, para redes e hospedagens que bloqueiam
# as portas SMTP. Com a chave definida, o Brevo tem prioridade e MAIL_PASSWORD fica
# sem uso. Use a chave DE API (começa com xkeysib-), não a SMTP (xsmtpsib-). O
# remetente precisa estar verificado no Brevo e os IPs de saída do servidor
# autorizados (Docs/EMAILS_TRANSACIONAIS.md).
BREVO_API_KEY=
# Opcional: padrão https://api.brevo.com/v3/smtp/email (precisa ser https).
BREVO_API_URL=
# Prazo (s) de cada tentativa de envio, API e SMTP (1 a 60; padrão 15).
NEXO_EMAIL_TIMEOUT=15
# 1 = aviso no sininho dos administradores quando o provedor recusa um e-mail
# (padrão: ligado em produção, desligado em desenvolvimento).
NEXO_EMAIL_ALERTA_ADMIN=
# Hospedagem que bloqueia SMTP: 1 confirma que as portas 465/587 foram liberadas.
NEXO_SMTP_PERMITIDO=0
# Opcionais. Sem credenciais, preserva os fallbacks locais de IA/NexoBot.
ANTHROPIC_API_KEY=
# NexoBot funciona sem token. Com token fine-grained ("Make calls to Inference
# Providers"), um modelo apenas redige respostas do Guia (uso cobrado pela HF).
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
